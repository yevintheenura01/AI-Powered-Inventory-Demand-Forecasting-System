# Dependency directories across services
**/node_modules/
**/bower_components/

# Python Virtual Environments
**/venv/
**/.venv/
**/env/
**/ENV/

# Python Bytecode
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Environment files (sensitive credentials)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Build outputs
**/dist/
**/dist-ssr/
**/build/
**/out/

# Log files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# OS-specific files
**/.DS_Store
**/Thumbs.db

# IDEs and Editors
**/.vscode/
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?
**/.project
**/.classpath
**/.settings/
